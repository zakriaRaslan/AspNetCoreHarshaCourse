@model GridPersonModel
<div class="box">
    <h3>@Model.GridTitle</h3>
    <table class="table w-100">
  <thead>
      <tr>
          <td>
              Name
          </td>
          <td>
              Jop Title
          </td>
      </tr>
  </thead>
  <tbody>
      @foreach(Person person in Model.Persons){
                <tr>
                    <td>
                       @person.Name
                    </td>
                    <td>
                        @person.JopTitle
                    </td>
                </tr>
      }
     
  </tbody>
</table>
</div>