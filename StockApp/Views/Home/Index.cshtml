@model StockApp.Models.Stock

@{
    ViewBag.Title = "Home";
}

<div class="box trading-panel">

    <div class="flex trading-panel-flex">

        <div id="stock-price-panel">

            <div class="stock">
                <h1 class="stock-title">@Model.StockSymbol</h1>

                <table>
                    <tbody>
                        <tr>
                            <td>Current:</td>
                            <th><small>$</small> <span class="price">@Model.CurrentPrice.ToString("N")</span></th>
                        </tr>

                        <tr>
                            <td>High:</td>
                            <th><small>$</small> <span class="price">@Model.HighPriceOfTheDay.ToString("N")</span></th>
                        </tr>

                        <tr>
                            <td>Low:</td>
                            <th><small>$</small> <span class="price">@Model.LowPriceOfTheday.ToString("N")</span></th>
                        </tr>

                        <tr>
                            <td>Open:</td>
                            <th><small>$</small> <span class="price">@Model.OpenPriceOfTheDay.ToString("N")</span></th>
                        </tr>
                        <tr>
                            <td>Percent Change:</td>
                            <th><small>$</small> <span class="price">@Model.PercentChange.ToString("N")</span></th>
                        </tr>
                        <tr>
                            <td>Previous Close:</td>
                            <th><small>$</small> <span class="price">@Model.PreviousClosePrice.ToString("N")</span></th>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>