<button class="button button-blue-back" id="display-button" type="button">
    Display Languages </button>

    <div class="box programming-lang-list">

    </div>

<script>
    document.querySelector("#display-button").addEventListener("click", async function(){
        var response = await fetch("programming-lang-list");
        var languagesList = await response.text();
        document.querySelector(".programming-lang-list").innerHTML = languagesList;
    });

</script>